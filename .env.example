DATABASE_URL=
TEST_DATABASE_URL=
# Who signs owners in; the web app's NEXT_PUBLIC_AUTH_PROVIDER (frontend/.env.example) must match.
# "local" (default): the backend's own email + password login, a session cookie plus the CSRF header;
# needs the web app on the API's origin (the self-hosted Docker stack in deploy/, or `npm run dev`
# with its /api proxy). "supabase": Supabase Auth; the web app sends the access token as
# "Authorization: Bearer", cookies are ignored, and /auth/signup, /auth/login, /auth/logout answer
# 404 (the hosted Render deployment, render.yaml). Who may sign up is then set in Supabase.
AUTH_PROVIDER=local
# Read only with AUTH_PROVIDER=supabase. SUPABASE_URL is https://<project-ref>.supabase.co and also
# pins the token issuer. Verification keys: SUPABASE_JWKS_URL (<SUPABASE_URL>/auth/v1/.well-known/
# jwks.json, for projects with asymmetric signing keys) or SUPABASE_JWT_SECRET (the legacy HS256 JWT
# secret; ignored when SUPABASE_JWKS_URL is set). With neither, every login is refused (fail closed).
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Owner accounts and login sessions (AUTH_PROVIDER=local only). AUTH_COOKIE_SECURE=false only for
# plain-http local development (the session cookie is then sent without the Secure flag). With
# AUTH_ALLOW_SIGNUP=false, create accounts with backend/scripts/create_user.py. Sessions last
# AUTH_SESSION_TTL_HOURS after last use, and end AUTH_SESSION_MAX_AGE_DAYS (1 to 366) after login
# however active they are.
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_SIGNUP=true
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_MAX_AGE_DAYS=30
# true serves the API docs (/docs, /redoc) and schema (/openapi.json) to anyone, without a login.
# Enable it only for local development; keep it false on any server.
API_DOCS_ENABLED=false
# Read by uvicorn, not by the app: addresses (IPs or CIDRs, comma-separated) whose X-Forwarded-For is
# trusted. Behind a reverse proxy, set it to the proxy's address so that login rate limits see client
# addresses instead of the proxy's (uvicorn's default trusts loopback only). Unset otherwise.
# FORWARDED_ALLOW_IPS=
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# LLM provider: "anthropic" (the API, default; needs ANTHROPIC_API_KEY), "claude_cli" (headless
# Claude Code with your Claude Code login), "liara" (Liara's OpenAI-compatible AI project API), or
# "top_tools" (Top Tools' OpenAI-compatible API), "gemini" (Google Gemini's OpenAI-compatible API), or
# "chain" (the providers of LLM_CHAIN in order: each model call falls through to the next provider after
# a rate-limit, quota, auth, unknown-model, server or timeout error or an empty/invalid response).
# An unknown LLM_PROVIDER does not stop the app; agent runs fail with a configuration error instead.
# claude_cli needs `uv sync --group headless`, no API key, and uses the bundled CLI or `claude` on PATH.
LLM_PROVIDER=anthropic
CLAUDE_CLI_MODEL=claude-opus-5-5
CLAUDE_CLI_EFFORT=medium
CLAUDE_CLI_PATH=
# Provider order for LLM_PROVIDER=chain (gemini, top_tools, liara). A key or provider that returned a
# quota/rate-limit (429) or auth (401/403) error is skipped for LLM_COOLDOWN_SECONDS.
LLM_CHAIN=gemini,top_tools
LLM_COOLDOWN_SECONDS=60
# Google Gemini (LLM_PROVIDER=gemini, or "gemini" in LLM_CHAIN). GEMINI_API_KEYS is comma-separated (up to
# 5 keys, tried in turn); GEMINI_API_KEY, GEMINI_API_KEY_2 and GEMINI_API_KEY_3 are also accepted.
# Free-tier keys: keep a Flash model, Pro models return 429 on the free tier.
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_STRONG=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MAX_TOKENS=32000
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=1
GEMINI_TOKEN_PRICES_JSON=
# Liara AI (LLM_PROVIDER=liara). Use a project-scoped AI key, never a Liara account API key. The base
# URL is the project's documented endpoint, for example https://ai.liara.ir/api/v1/<project-id>.
LIARA_API_KEY=
LIARA_BASE_URL=
LIARA_MODEL_STRONG=google/gemini-3.8-flash
LIARA_MODEL_FAST=deepseek/deepseek-v4-flash
LIARA_MAX_TOKENS=32000
LIARA_TIMEOUT_SECONDS=180
LIARA_MAX_RETRIES=2
# Optional USD prices per one million tokens, e.g. {"model":{"input":0,"output":0,"cache_read":0}}.
# Leave empty when prices are unknown: reported cost is unpriced (0 estimate), never free.
LIARA_TOKEN_PRICES_JSON=
# Top Tools AI (LLM_PROVIDER=top_tools). Keep the documented /api/v1 endpoint unless your provider
# configuration explicitly supplies https://top-tools-ai.com/v1 instead. API key and both model IDs are
# required; the requested labels ClaudeOpus5 and GPT5.6Sol do not establish API IDs. Configure confirmed IDs.
TOP_TOOLS_API_KEY=
TOP_TOOLS_BASE_URL=https://top-tools-ai.com/api/v1
TOP_TOOLS_MODEL_STRONG=
TOP_TOOLS_MODEL_FAST=
TOP_TOOLS_MAX_TOKENS=32000
TOP_TOOLS_TIMEOUT_SECONDS=180
TOP_TOOLS_MAX_RETRIES=2
# Optional USD prices per one million tokens: {"model":{"input":0,"output":0,"cache_read":0}}.
# Empty means cost is unpriced (a zero estimate), not free.
TOP_TOOLS_TOKEN_PRICES_JSON=
TOKEN_ENC_KEY=
# Telegram updates: "webhook" (default; Telegram posts to {PUBLIC_BASE_URL}/tg/<bot id>, so
# PUBLIC_BASE_URL must be a public https address Telegram can reach) or "polling" (the backend fetches
# them with getUpdates, outbound only, through HTTPS_PROXY / ALL_PROXY if set; PUBLIC_BASE_URL is then
# not used for Telegram). Use polling where Telegram cannot reach the machine (local development, or a
# server in Iran). Run exactly one backend process in polling mode.
TELEGRAM_MODE=webhook
PUBLIC_BASE_URL=
# Comma-separated web app origins for CORS, e.g. https://app.example.com,https://www.example.com
FRONTEND_ORIGIN=
# Optional, usually empty: a regex for preview origins (README, Deployment checklist, step 5)
FRONTEND_ORIGIN_REGEX=
LOG_LLM_BODIES=
