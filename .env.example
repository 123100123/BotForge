DATABASE_URL=
TEST_DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# LLM provider: anthropic (default) or openai (OpenAI-compatible endpoint chain; README "Environment").
# Chain order: LLM_1_*, LLM_2_*, ... (up to LLM_5_*, stops at the first empty BASE_URL), then LLM_BASE_URL last.
LLM_PROVIDER=anthropic
LLM_1_BASE_URL=
LLM_1_API_KEY=
LLM_1_MODEL_STRONG=
LLM_1_MODEL_FAST=
LLM_2_BASE_URL=
LLM_2_API_KEY=
LLM_2_MODEL_STRONG=
LLM_2_MODEL_FAST=
# The plain endpoint (last in the chain), e.g. https://top-tools-ai.com/v1 with LLM_MODEL_STRONG=Qwen-3.8-Max
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=4
LLM_MAX_TOKENS=16384
LLM_COOLDOWN_SECONDS=60
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
TOKEN_ENC_KEY=
PUBLIC_BASE_URL=
# Comma-separated web app origins for CORS, e.g. https://app.example.com,https://www.example.com
FRONTEND_ORIGIN=
# Optional, usually empty: a regex for preview origins (README, Deployment checklist, step 5)
FRONTEND_ORIGIN_REGEX=
LOG_LLM_BODIES=
