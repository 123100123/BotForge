DATABASE_URL=
TEST_DATABASE_URL=
# Owner accounts and login sessions. AUTH_COOKIE_SECURE=false only for plain-http local development
# (the session cookie is then sent without the Secure flag). With AUTH_ALLOW_SIGNUP=false, create
# accounts with backend/scripts/create_user.py. Sessions last AUTH_SESSION_TTL_HOURS after last use.
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_SIGNUP=true
AUTH_SESSION_TTL_HOURS=168
# Read by uvicorn, not by the app: addresses (IPs or CIDRs, comma-separated) whose X-Forwarded-For is
# trusted. Behind a reverse proxy, set it to the proxy's address so that login rate limits see client
# addresses instead of the proxy's (uvicorn's default trusts loopback only). Unset otherwise.
# FORWARDED_ALLOW_IPS=
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# LLM provider: "anthropic" (the API, default; needs ANTHROPIC_API_KEY) or "claude_cli" (headless
# Claude Code with your Claude Code login, for local development and live evals; no API key, needs
# `uv sync --group headless`). CLAUDE_CLI_PATH is optional: by default the CLI bundled with
# claude-agent-sdk is used, else `claude` on PATH.
LLM_PROVIDER=anthropic
CLAUDE_CLI_MODEL=claude-opus-5-5
CLAUDE_CLI_EFFORT=medium
CLAUDE_CLI_PATH=
TOKEN_ENC_KEY=
PUBLIC_BASE_URL=
# FRONTEND_ORIGIN: one origin, or several separated by commas (CORS)
FRONTEND_ORIGIN=
LOG_LLM_BODIES=
