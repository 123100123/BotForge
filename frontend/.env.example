# BotForge frontend environment (all values are public; never put secrets here).
# Copy to .env.local and adjust.

# 1 = mock mode: fake auth (login and signup work offline) and a fixture-driven API and agent event stream.
# Leave unset (or 0) to talk to the real backend.
NEXT_PUBLIC_MOCK=1

# Base URL of the backend API, without a trailing slash. Keep it same-origin: the session is an
# HttpOnly cookie set by the backend and sent with credentials "same-origin".
# Production: Caddy serves the frontend at / and proxies /api/* to the backend with the prefix stripped.
# `npm run dev`: next.config.ts proxies /api/* to http://localhost:8000/* (development only).
NEXT_PUBLIC_API_BASE_URL=/api
