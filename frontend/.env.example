# BotForge frontend environment (all values are public; never put secrets here).
# Copy to .env.local and adjust.

# 1 = mock mode: fake sign-in (any email and password) and a fixture-driven API and agent event stream.
# Mock mode is also used automatically whenever the Supabase variables below are empty.
# Set to 0 and fill in the variables below to talk to the real backend.
NEXT_PUBLIC_MOCK=1

# Base URL of the FastAPI backend, without a trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project (auth only; the frontend never reads data from Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
