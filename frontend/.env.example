# BotForge frontend environment (all values are public; never put secrets here).
# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time: rebuild after a change.

# 1 = mock mode: fake auth (login and signup work offline) and a fixture-driven API and agent event stream.
# Mock mode is used only when this is exactly 1. Any other value (or none) is real mode and talks to the
# real backend.
NEXT_PUBLIC_MOCK=1

# Who signs owners in; must name the same provider as the backend's AUTH_PROVIDER.
# local (default): the backend's own login. The session is an HttpOnly cookie set by the backend and
#   sent with credentials "same-origin", so NEXT_PUBLIC_API_BASE_URL must be same-origin (/api).
# supabase: Supabase Auth in the browser. Every API call carries the access token as
#   "Authorization: Bearer" and no cookies, so NEXT_PUBLIC_API_BASE_URL may be another origin (the
#   hosted Render deployment). Needs the two NEXT_PUBLIC_SUPABASE_* values below; without them (or
#   with an unknown provider name) real mode shows a configuration error page.
NEXT_PUBLIC_AUTH_PROVIDER=local

# Base URL of the backend API, without a trailing slash.
# Own login: keep it same-origin. Production: Caddy serves the frontend at / and proxies /api/* to the
# backend with the prefix stripped. `npm run dev`: next.config.ts proxies /api/* to
# http://localhost:8000/* (development only).
# Supabase sign-in: the API's public URL, e.g. https://botforge-api.onrender.com (the API's
# FRONTEND_ORIGIN must then list this web app's origin).
NEXT_PUBLIC_API_BASE_URL=/api

# Supabase project, read only with NEXT_PUBLIC_AUTH_PROVIDER=supabase (authentication only; the
# frontend never reads data from Supabase). The URL must be https (http only for localhost). The key
# is the anon/publishable key, never the service-role key.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
