# Settings for the LOCAL REHEARSAL (docker-compose.local.yml, ./local.sh). Never use on the VPS.
#     cp .env.local.example .env.local     (git ignores .env.local)
# docker-compose.local.yml already sets the proxy, the localhost URLs and LLM_PROVIDER=claude_cli.

SITE_HOST=localhost
ACME_EMAIL=

POSTGRES_USER=botforge
POSTGRES_PASSWORD=local-rehearsal-only
POSTGRES_DB=botforge

# From backend/:  uv run python -m app.security.crypto generate-key
TOKEN_ENC_KEY=

# Run `claude setup-token` once and paste the token it prints (long-lived, uses your Claude login).
CLAUDE_CODE_OAUTH_TOKEN=

# 1 = frontend demo mode with fake data; empty for the real API.
NEXT_PUBLIC_MOCK=
AUTH_COOKIE_SECURE=true

# Only for real Telegram through a tunnel (deploy/LOCAL-REHEARSAL.md, Stage 3): the tunnel's public
# https URL, without a trailing slash. Leave commented out otherwise (it defaults to https://localhost).
#PUBLIC_BASE_URL=https://example-words.trycloudflare.com
