# BotForge self-hosting settings. Copy to deploy/.env (git ignores it) and fill it in:
#     cp .env.example .env && chmod 600 .env
# Docker Compose reads deploy/.env automatically when you run it from deploy/.
# Never commit deploy/.env. Values must not be quoted and must not contain spaces.

# --- Site address (set once; Caddy, CORS and the Telegram webhook base all derive from it) ---
# The public hostname, without https:// and without a trailing slash. Use a free sslip.io name made
# from the server IP, dots replaced by dashes: IP 203.0.113.7 -> 203-0-113-7.sslip.io
# (Caddy gets a real HTTPS certificate for it). Later, point a real domain's A record at the server
# and put that name here. For a local test on your own machine use: localhost
SITE_HOST=203-0-113-7.sslip.io

# Optional: email for the Let's Encrypt / ZeroSSL account (expiry notices). Leave empty to skip.
ACME_EMAIL=

# --- How Telegram updates reach the backend ---
# webhook (default): Telegram sends every update to https://SITE_HOST/tg/<bot id>, so Telegram's
#   servers must be able to reach this server over the internet.
# polling: the backend asks Telegram for updates (getUpdates), using outbound connections only
#   (through OUTBOUND_HTTPS_PROXY below if set). Use it on a VPS that Telegram cannot reach inbound, as
#   is likely in Iran. SITE_HOST (and PUBLIC_BASE_URL) are then used only for the site itself.
# Switching from polling back to webhook: restart, then run scripts/reregister_webhooks.py once (README).
TELEGRAM_MODE=webhook

# --- Postgres (runs in the db container, never reachable from outside the server) ---
# Use a URL-safe password: it is placed inside DATABASE_URL. Generate one with:  openssl rand -hex 24
POSTGRES_USER=botforge
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=botforge

# --- Backend ---
# Key that encrypts stored Telegram bot tokens. Generate ONCE and back it up; losing it orphans every
# stored bot token. Without a local Python environment, run it in the image after the first build:
#     TOKEN_ENC_KEY=x docker compose run --rm --no-deps backend python -m app.security.crypto generate-key
# (or, from backend/ on any machine with uv:  uv run python -m app.security.crypto generate-key)
TOKEN_ENC_KEY=replace-with-the-generated-key

# LLM: "anthropic" is the only provider for a server.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model overrides; empty uses the backend defaults.
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# Keep false: LLM request bodies contain owner chat text.
LOG_LLM_BODIES=false
# Keep false on the server: true serves the API docs and the full API map (/api/docs, /api/redoc,
# /api/openapi.json) to anyone, without a login. Enable it only for local development.
API_DOCS_ENABLED=false
# Agent run limits (cost control). Lower the daily cap before a public demo.
AGENT_DAILY_RUN_CAP=30
AGENT_RUNS_PER_MINUTE=5
# Manager Copilot questions per owner account per rolling 24 hours (cost control, like the cap above).
COPILOT_DAILY_CAP=50

# --- Notifications (event reminders, announcements, scheduled reports) ---
# true: the backend sends queued Telegram notifications from a background ticker. Compose defaults it to
# true; set false to stop all outgoing notifications (bots still answer users normally).
NOTIFICATIONS_TICKER=true
# How often (seconds) the ticker looks for due messages.
NOTIFICATIONS_TICK_SECONDS=20
# Maximum messages sent per second across all bots (Telegram allows about 30 per bot token; keep below).
NOTIFICATIONS_SEND_RATE_PER_SECOND=15

# --- Spreadsheet uploads (Data Analyst) ---
# Files are stored on the `uploads` Docker volume (UPLOAD_DIR is fixed to /data/uploads in compose).
# Back that volume up together with the database. Limits per uploaded file:
UPLOAD_MAX_BYTES=5242880
SPREADSHEET_MAX_ROWS=50000
SPREADSHEET_MAX_COLUMNS=100

# --- Login (BotForge's own email + password login; sessions live in Postgres, cookie bf_session) ---
# The session cookie is HttpOnly. Keep this true: the site is served over HTTPS, and a cookie without
# the Secure flag would also travel over plain HTTP. Set false only for a local http:// test.
AUTH_COOKIE_SECURE=true
# true: anyone who can reach the site can register an account. Set false once your own account exists
# (create it first from the command line, see the README) to close registration.
AUTH_ALLOW_SIGNUP=true
# A login ends this many hours after it was last used (168 = 7 days)...
AUTH_SESSION_TTL_HOURS=168
# ...and at the latest this many days after it began, however active (1 to 366). So a stolen session
# cookie stops working after this long even if it is used every day.
AUTH_SESSION_MAX_AGE_DAYS=30

# --- Frontend build arguments (inlined into the JavaScript at BUILD time) ---
# Changing any of these needs a rebuild:  docker compose up -d --build
# "/api" is the same-origin path Caddy forwards to the backend. Leave it as is.
NEXT_PUBLIC_API_BASE_URL=/api
# 1 = demo mode with fake data and no backend calls. Leave empty for a real deployment.
NEXT_PUBLIC_MOCK=

# --- Iran / restricted network (all optional; leave empty on an unrestricted server) ---
# Docker Hub and ghcr.io may be blocked. For base images set a registry mirror in
# /etc/docker/daemon.json (see the README, "Restricted networks"). The settings below cover the rest.
#
# OUTBOUND proxy for the backend and Caddy containers (Telegram API, the LLM API, and Caddy's ACME
# requests to Let's Encrypt / ZeroSSL). Without it a blocked Telegram or a blocked ACME server fails.
# The names are OUTBOUND_* on purpose, so a proxy exported in your own shell cannot leak in.
# The containers get them as HTTP_PROXY / HTTPS_PROXY / NO_PROXY. Example: http://host.docker.internal:10808
# (a proxy running on the server itself; compose maps host.docker.internal to the host).
OUTBOUND_HTTP_PROXY=
OUTBOUND_HTTPS_PROXY=
# Extra hosts that must bypass the proxy. db, backend, frontend, localhost and 127.0.0.1 are always
# excluded; list only additions, comma separated.
OUTBOUND_NO_PROXY=
#
# Proxy used only while BUILDING the images. Often the same value.
BUILD_PROXY=
# A PyPI mirror for the backend build (pip and uv), e.g. an Iranian mirror's /simple/ URL.
PIP_INDEX_URL=
# An npm registry mirror for the frontend build.
NPM_CONFIG_REGISTRY=
#
# An Anthropic-compatible mirror's base URL (for example an Iranian reseller). Empty uses
# https://api.anthropic.com. WARNING: the mirror sees every prompt, including owner chat text, and it
# may not support every API feature the agent uses; test it first (README, "Restricted networks").
# Use the mirror's own key in ANTHROPIC_API_KEY above.
ANTHROPIC_BASE_URL=

# --- Internal network (change only if 10.250.77.0/24 collides with a network on your server) ---
# Caddy gets a fixed address; the backend trusts X-Forwarded-For only from that address, so the
# rate limiter sees each visitor's real IP instead of Caddy's. CADDY_IP must be inside CADDY_SUBNET.
#CADDY_SUBNET=10.250.77.0/24
#CADDY_IP=10.250.77.10
